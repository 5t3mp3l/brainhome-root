# Ignore everything by default
*

# Track only specific root-level files
!.gitignore
!BrainHome.code-workspace
!INFRASTRUCTURE.md
!ERLERNTES-WISSEN.md
!TODO.md
!paths.toml
!paths.local.example.toml
!PATHS.md
!.vscode/
!.vscode/settings.json

# Track workstation tools and docs
!workstation/
workstation/*
!workstation/tools/
workstation/tools/*
!workstation/tools/cluster-inventory.sh
!workstation/scripts/
workstation/scripts/*
!workstation/scripts/remmina-setup-ct113.sh
!workstation/docs/
workstation/docs/*
!workstation/docs/ssh-config.md
!workstation/docs/remmina-client-setup.md

# Track brainhome-cron tool + registry (explicit paths, 3-level deep)
!tools/
!tools/bin/
!tools/bin/brainhome
!tools/bin/brainhome-cron
!tools/bin/brainhome-discover
!tools/bin/brainhome-docu
!tools/bin/brainhome-devctl
!tools/bin/devctl
!tools/bin/brainhome-git
!tools/bin/brainhome-inventory
!tools/bin/brainhome-new-module
!tools/bin/brainhome-path-preflight
!tools/bin/brainhome-proxmox-node-mirrors
!tools/bin/brainhome-smokefix
!tools/bin/brainhome-smoketest
!tools/bin/brainhome-status
!tools/bin/brainhome-taskcheck
!tools/bin/brainhome-tasks
!tools/lib/
!tools/lib/paths.sh
!tools/lib/paths.py
!tools/lib/inventory-manager.py
!tools/lib/log-collector.sh
!tools/lib/module-discovery.py
!tools/lib/module-scaffold.py
!tools/lib/task-generator.py
!tools/lib/task-health-check.py
!tools/lib/task-smoke-remediate.py
!tools/lib/task-smoketest.py
!tools/config/
!tools/config/cron-registry.json
!tools/config/path-preflight-allowlist.txt

# Track pihole sync script
!pihole/
!pihole/scripts/
!pihole/scripts/pihole-sync.py

# Track HA addon sync script
!HomeAssistant/
!HomeAssistant/scripts/
!HomeAssistant/scripts/ha-addon-update-sync.py
!HomeAssistant/tools/
!HomeAssistant/tools/devctl.sh
!HomeAssistant/paths.toml

# Path-manifest pilot for non-nested workstation tooling.
!workstation/paths.toml

# Path-manifest pilot for the independently scheduled OpenWrt repeater module.
!openwrt-repeater-setup/
openwrt-repeater-setup/*
!openwrt-repeater-setup/paths.toml
!openwrt-repeater-setup/monitor-wifi-aps.sh

# Path-manifest coverage for the AI-on-the-edge parent and meter submodules.
!AI-on-the-edge/
AI-on-the-edge/*
!AI-on-the-edge/paths.toml
!AI-on-the-edge/gasmeter/
AI-on-the-edge/gasmeter/*
!AI-on-the-edge/gasmeter/paths.toml
!AI-on-the-edge/strommeter/
AI-on-the-edge/strommeter/*
!AI-on-the-edge/strommeter/paths.toml

# Versioned path manifests. Local host/user overrides stay ignored.
!**/paths.toml
!**/paths.local.example.toml
paths.local.toml

