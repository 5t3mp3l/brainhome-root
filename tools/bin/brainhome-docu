#!/bin/bash
# =============================================================================
# brainhome-docu — Entwickler-Wissen Knowledge Base Tool
#
# Sucht, zeigt und pflegt ENTWICKLER-WISSEN.md Dateien aller Module.
# Neues Wissen wird nach Ticket-Abschluss über dieses Tool eingepflegt.
#
# Usage:
#   brainhome docu list                        Alle Module mit Wissen-Dateien
#   brainhome docu show <module>               Wissen eines Moduls anzeigen
#   brainhome docu search <keyword>            In allen Modulen suchen
#   brainhome docu search <keyword> --module <m>  Nur in einem Modul suchen
#   brainhome docu add-lesson <module> "<title>" "<text>"  Lektion hinzufügen
#   brainhome docu add-lesson-ticket <ticket-id> <module> "<title>" "<text>"
# =============================================================================

set -euo pipefail

_SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
TOOLS_ROOT="${TOOLS_ROOT:-$(dirname "$_SCRIPT_DIR")}"
MODULES_JSON="$TOOLS_ROOT/config/modules.json"

# Colors
BOLD='\033[1m'
DIM='\033[2m'
CYAN='\033[0;36m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
RED='\033[0;31m'
BLUE='\033[0;34m'
NC='\033[0m'

log_info()    { echo -e "${BLUE}[INFO]${NC} $*"; }
log_ok()      { echo -e "${GREEN}[OK]${NC}   $*"; }
log_warn()    { echo -e "${YELLOW}[⚠]${NC}  $*"; }
log_error()   { echo -e "${RED}[✗]${NC}   $*" >&2; }
separator()   { echo -e "${DIM}────────────────────────────────────────────────────────────${NC}"; }

# ---------------------------------------------------------------------------
# Hilfsfunktionen
# ---------------------------------------------------------------------------

# Gibt alle bekannten Modul-Pfade aus modules.json zurück (name:path)
_module_paths() {
    if [[ -f "$MODULES_JSON" ]]; then
        python3 -c "
import json, sys
with open('$MODULES_JSON') as f:
    data = json.load(f)
for name, m in data.get('modules', {}).items():
    print(name + ':' + m['path'])
" 2>/dev/null
    fi
}

# Findet die ENTWICKLER-WISSEN.md für ein Modul (name oder path)
_resolve_doc_file() {
    local module="$1"
    # Direkt als Pfad?
    if [[ "$module" == /* ]] && [[ -d "$module" ]]; then
        echo "$module/ENTWICKLER-WISSEN.md"
        return
    fi
    # Aus modules.json
    local path
    path=$(python3 -c "
import json, sys
with open('$MODULES_JSON') as f:
    data = json.load(f)
m = data.get('modules', {}).get('$module', {})
print(m.get('path', ''))
" 2>/dev/null)
    if [[ -n "$path" ]]; then
        echo "$path/ENTWICKLER-WISSEN.md"
        return
    fi
    # Fallback: /home/<module>/ENTWICKLER-WISSEN.md
    if [[ -d "/home/$module" ]]; then
        echo "/home/$module/ENTWICKLER-WISSEN.md"
        return
    fi
    echo ""
}

# Bestimmt die nächste freie §N-Nummer in einer Wissen-Datei
_next_section_num() {
    local doc_file="$1"
    local num=2
    if [[ -f "$doc_file" ]]; then
        local max
        max=$(grep -E '^## [0-9]+\.' "$doc_file" 2>/dev/null \
            | grep -oE '[0-9]+' | head -1 \
            | sort -n | tail -1 || true)
        # Korrekt: alle §N-Nummern sammeln und Maximum nehmen
        max=$(grep -oE '^## ([0-9]+)\.' "$doc_file" 2>/dev/null \
            | grep -oE '[0-9]+' | sort -n | tail -1 || true)
        if [[ -n "$max" ]]; then
            num=$(( max + 1 ))
        fi
    fi
    echo "$num"
}

# ---------------------------------------------------------------------------
# Subcommands
# ---------------------------------------------------------------------------

cmd_list() {
    echo
    echo -e "  ${BOLD}${CYAN}BrainHome Entwickler-Wissen – Übersicht${NC}"
    separator
    printf "  %-22s %-6s  %s\n" "MODUL" "§§" "DATEI"
    separator

    local found=0
    while IFS=: read -r name path; do
        local doc="$path/ENTWICKLER-WISSEN.md"
        if [[ -f "$doc" ]]; then
            local sections
            sections=$(grep -cE '^## [0-9]+\.' "$doc" 2>/dev/null || echo 0)
            printf "  ${GREEN}%-22s${NC} ${CYAN}%-6s${NC}  ${DIM}%s${NC}\n" \
                "$name" "§$sections" "$doc"
            found=$(( found + 1 ))
        fi
    done < <(_module_paths)

    # Auch Dateien finden, die nicht im Registry sind
    while IFS= read -r doc; do
        local mod_path
        mod_path=$(dirname "$doc")
        local mod_name
        mod_name=$(basename "$mod_path")
        # Prüfen ob schon ausgegeben
        if ! _module_paths | grep -q ":$mod_path$"; then
            local sections
            sections=$(grep -cE '^## [0-9]+\.' "$doc" 2>/dev/null || echo 0)
            printf "  ${YELLOW}%-22s${NC} ${CYAN}%-6s${NC}  ${DIM}%s${NC}\n" \
                "$mod_name*" "§$sections" "$doc"
            found=$(( found + 1 ))
        fi
    done < <(find /home -maxdepth 3 -name "ENTWICKLER-WISSEN.md" \
        ! -path "*/workstation/backup/*" 2>/dev/null | sort)

    separator
    echo -e "  ${DIM}$found Wissen-Dateien gefunden.  (* = nicht im Module-Registry)${NC}"
    echo
    echo -e "  ${BOLD}Befehle:${NC}"
    echo -e "    ${CYAN}brainhome docu show <modul>${NC}        Wissen anzeigen"
    echo -e "    ${CYAN}brainhome docu search <keyword>${NC}    In allen Modulen suchen"
    echo -e "    ${CYAN}brainhome docu add-lesson <modul> \"<titel>\" \"<text>\"${NC}"
    echo
}

cmd_show() {
    local module="${1:-}"
    if [[ -z "$module" ]]; then
        log_error "Verwendung: brainhome docu show <modul>"
        exit 1
    fi
    local doc_file
    doc_file=$(_resolve_doc_file "$module")
    if [[ -z "$doc_file" || ! -f "$doc_file" ]]; then
        log_error "Keine ENTWICKLER-WISSEN.md für Modul '$module' gefunden."
        echo -e "  ${DIM}Gesucht: $doc_file${NC}"
        echo -e "  ${DIM}Tipp: brainhome docu list${NC}"
        exit 1
    fi
    echo
    echo -e "  ${BOLD}${CYAN}Entwickler-Wissen: $module${NC}"
    separator
    cat "$doc_file"
    echo
}

cmd_search() {
    local keyword="${1:-}"
    local filter_module=""
    shift || true
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --module|-m) filter_module="${2:-}"; shift 2 ;;
            *) shift ;;
        esac
    done

    if [[ -z "$keyword" ]]; then
        log_error "Verwendung: brainhome docu search <keyword> [--module <m>]"
        exit 1
    fi

    echo
    echo -e "  ${BOLD}${CYAN}Entwickler-Wissen Suche: \"$keyword\"${NC}"
    separator

    local total_hits=0

    _collect_files() {
        if [[ -n "$filter_module" ]]; then
            local doc_file
            doc_file=$(_resolve_doc_file "$filter_module")
            [[ -n "$doc_file" && -f "$doc_file" ]] && echo "$doc_file"
        else
            while IFS=: read -r name path; do
                local doc="$path/ENTWICKLER-WISSEN.md"
                [[ -f "$doc" ]] && echo "$doc"
            done < <(_module_paths)
            # Nicht-registry Dateien
            find /home -maxdepth 3 -name "ENTWICKLER-WISSEN.md" \
                ! -path "*/workstation/backup/*" 2>/dev/null | sort
        fi
    }

    local seen=()
    while IFS= read -r doc; do
        # Duplikate vermeiden
        local already=0
        for s in "${seen[@]:-}"; do [[ "$s" == "$doc" ]] && already=1 && break; done
        [[ $already -eq 1 ]] && continue
        seen+=("$doc")

        local mod_name
        mod_name=$(basename "$(dirname "$doc")")

        local hits
        hits=$(grep -c -i "$keyword" "$doc" 2>/dev/null || true)
        if [[ "$hits" -gt 0 ]]; then
            total_hits=$(( total_hits + hits ))
            echo
            echo -e "  ${BOLD}${GREEN}▶ $mod_name${NC}  ${DIM}($doc)${NC}"
            separator
            # Zeige Kontext um Treffer
            grep -n -i --color=always -A 2 -B 1 "$keyword" "$doc" 2>/dev/null \
                | head -40 | sed 's/^/    /'
            if [[ "$hits" -gt 10 ]]; then
                echo -e "    ${DIM}... und weitere $(( hits - 10 )) Treffer${NC}"
            fi
        fi
    done < <(_collect_files)

    echo
    if [[ $total_hits -eq 0 ]]; then
        log_warn "Keine Treffer für \"$keyword\" gefunden."
        echo -e "  ${DIM}Tipp: brainhome docu list  –  verfügbare Wissen-Dateien${NC}"
    else
        echo -e "  ${GREEN}$total_hits Treffer${NC} für \"${BOLD}$keyword${NC}\" gefunden."
    fi
    echo
}

cmd_add_lesson() {
    local module="${1:-}"
    local title="${2:-}"
    local text="${3:-}"
    local ticket_id="${4:-}"  # optional

    if [[ -z "$module" || -z "$title" || -z "$text" ]]; then
        log_error "Verwendung: brainhome docu add-lesson <modul> \"<titel>\" \"<text>\""
        log_error "           brainhome docu add-lesson-ticket <ticket-id> <modul> \"<titel>\" \"<text>\""
        exit 1
    fi

    local doc_file
    doc_file=$(_resolve_doc_file "$module")
    if [[ -z "$doc_file" ]]; then
        log_error "Modul '$module' nicht gefunden."
        exit 1
    fi

    # Datei anlegen falls noch nicht vorhanden
    if [[ ! -f "$doc_file" ]]; then
        mkdir -p "$(dirname "$doc_file")"
        cat > "$doc_file" << HEADER
# $(basename "$(dirname "$doc_file")") – Entwickler-Wissen & Fallstricke

> Gesammeltes Wissen für Entwickler.
> Stand: $(date '+%B %Y')

---

HEADER
        log_info "ENTWICKLER-WISSEN.md angelegt: $doc_file"
    fi

    # Atomares Schreiben per Lock
    local lock_file="$doc_file.lock"
    (
        flock -x 200
        local section_num
        section_num=$(_next_section_num "$doc_file")
        local date_str
        date_str=$(date '+%d.%m.%Y')

        local ticket_ref=""
        if [[ -n "$ticket_id" ]]; then
            ticket_ref=" · Ticket: $ticket_id"
        fi

        printf '\n## %s. %s (%s%s)\n\n%s\n' \
            "$section_num" "$title" "$date_str" "$ticket_ref" "$text" \
            >> "$doc_file"

        log_ok "§${section_num} '${title}' in ${doc_file} eingefügt."
        if [[ -n "$ticket_id" ]]; then
            echo -e "     ${DIM}Ticket: $ticket_id${NC}"
        fi

        # Ticket-System benachrichtigen wenn ticket_id angegeben
        if [[ -n "$ticket_id" ]]; then
            local tickets_py="/home/webserver/tools/agent-tickets.py"
            if [[ -f "$tickets_py" ]]; then
                python3 "$tickets_py" note "$ticket_id" \
                    "DOCU: §${section_num} in ${doc_file} eingefügt" 2>/dev/null || true
            fi
        fi
    ) 200>"$lock_file"
}

cmd_add_lesson_ticket() {
    local ticket_id="${1:-}"
    local module="${2:-}"
    local title="${3:-}"
    local text="${4:-}"
    if [[ -z "$ticket_id" || -z "$module" || -z "$title" || -z "$text" ]]; then
        log_error "Verwendung: brainhome docu add-lesson-ticket <ticket-id> <modul> \"<titel>\" \"<text>\""
        exit 1
    fi
    cmd_add_lesson "$module" "$title" "$text" "$ticket_id"
}

cmd_help() {
    cat << 'EOF'

════════════════════════════════════════════════════════════════════
  BrainHome Entwickler-Wissen (docu)
════════════════════════════════════════════════════════════════════

BEFEHLE:

  list
    Alle Module mit ENTWICKLER-WISSEN.md und Abschnittszahl auflisten.

  show <modul>
    Vollständiges Entwickler-Wissen eines Moduls anzeigen.

  search <keyword> [--module <modul>]
    In allen (oder einem) Modul nach Stichwort suchen.
    Beispiel: brainhome docu search proxmox
    Beispiel: brainhome docu search "exit code" --module pxe-boot

  add-lesson <modul> "<titel>" "<text>"
    Neuen Wissens-Abschnitt in ENTWICKLER-WISSEN.md einfügen.
    Wird nach Ticket-Abschluss genutzt, um Erkenntnisse zu sichern.

  add-lesson-ticket <ticket-id> <modul> "<titel>" "<text>"
    Wie add-lesson, verknüpft aber zusätzlich das Ticket im Abschnitt.
    Empfohlen beim brainhome tickets done <id> Workflow.

WORKFLOW nach Ticket-Abschluss:

  1. brainhome tickets done <id> "Fertig"
     → Zeigt Reminder falls kein docu-Update vorhanden

  2. brainhome docu add-lesson-ticket <id> <modul> \
       "<Was war das Problem>" \
       "<Lösung, Fallstricke und wichtige Kommandos>"

BEISPIELE:

  brainhome docu list
  brainhome docu show pihole
  brainhome docu search "proxmox migration"
  brainhome docu search "exit code 255" --module pxe-boot
  brainhome docu add-lesson pihole \
    "v6 API: Token nur via Web-GUI" \
    "Pi-hole v6 hat neue REST-API. Token nicht via CLI generierbar."
  brainhome docu add-lesson-ticket A1B2C3 webserver \
    "Gradle UP-TO-DATE Problem" \
    "writeVersion war in falscher Phase. processResources.dependsOn fehlte."

════════════════════════════════════════════════════════════════════
EOF
}

# ---------------------------------------------------------------------------
# Main
# ---------------------------------------------------------------------------

if [[ $# -eq 0 ]]; then
    cmd_list
    exit 0
fi

CMD="$1"
shift

case "$CMD" in
    list)              cmd_list "$@" ;;
    show)              cmd_show "$@" ;;
    search)            cmd_search "$@" ;;
    add-lesson)        cmd_add_lesson "$@" ;;
    add-lesson-ticket) cmd_add_lesson_ticket "$@" ;;
    help|--help|-h)    cmd_help ;;
    *)
        log_error "Unbekannter Befehl: $CMD"
        echo "Verwende: brainhome docu help"
        exit 1
        ;;
esac
