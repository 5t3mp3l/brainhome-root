#!/bin/bash
# =============================================================================
# brainhome-git — Unified Git Guardrails for BrainHome agents
#
# Commands:
#   preflight   Validate repository state before agent work
#   work-start  Create/switch to standardized feature branch for a ticket
#   pr-ready    Validate branch is ready for PR creation
#   batch-add   Register branch/commit/pr metadata for automatic checks
#   batch-list  List registered metadata entries
#   batch-run   Run automatic checks for all registered entries
# =============================================================================

set -euo pipefail

GREEN='\033[0;32m'
YELLOW='\033[1;33m'
RED='\033[0;31m'
BLUE='\033[0;34m'
NC='\033[0m'

log_info()    { echo -e "${BLUE}[INFO]${NC} $*"; }
log_success() { echo -e "${GREEN}[OK]${NC}   $*"; }
log_warn()    { echo -e "${YELLOW}[WARN]${NC} $*"; }
log_error()   { echo -e "${RED}[ERR]${NC}  $*"; }

_TOOLS_ROOT_GIT="${TOOLS_ROOT:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)}"
BATCH_FILE="$_TOOLS_ROOT_GIT/logs/git-autoflow.json"
export BRAINHOME_GIT_SELF="${BASH_SOURCE[0]}"

is_protected_branch() {
  local b="${1:-}"
  [[ "$b" == "main" || "$b" == "master" ]]
}

sanitize_slug() {
  local raw="${1:-work}"
  echo "$raw" | tr '[:upper:]' '[:lower:]' | sed -E 's/[^a-z0-9]+/-/g; s/^-+//; s/-+$//; s/-+/-/g'
}

ensure_repo() {
  local repo="$1"
  if ! git -C "$repo" rev-parse --git-dir >/dev/null 2>&1; then
    log_error "Kein Git-Repository: $repo"
    exit 1
  fi
}

current_branch() {
  local repo="$1"
  git -C "$repo" symbolic-ref --quiet --short HEAD 2>/dev/null || echo ""
}

default_branch() {
  local repo="$1"
  local b
  b=$(git -C "$repo" symbolic-ref --quiet refs/remotes/origin/HEAD 2>/dev/null | sed 's@^refs/remotes/origin/@@' || true)
  if [[ -n "$b" ]]; then
    echo "$b"
    return 0
  fi
  if git -C "$repo" show-ref --verify --quiet refs/heads/main || git -C "$repo" show-ref --verify --quiet refs/remotes/origin/main; then
    echo "main"
    return 0
  fi
  if git -C "$repo" show-ref --verify --quiet refs/heads/master || git -C "$repo" show-ref --verify --quiet refs/remotes/origin/master; then
    echo "master"
    return 0
  fi
  echo ""
}

usage() {
  cat << 'EOF'
brainhome git <command> [options]

Commands:
  preflight  [--repo <path>] [--allow-dirty] [--allow-protected] [--no-remote-check] [--json] [--quiet]
  work-start <ticket> [--repo <path>] [--type feat|fix|chore|docs|refactor] [--slug <text>] [--base <branch>] [--allow-dirty] [--json] [--quiet]
  pr-ready   [--repo <path>] [--base <branch>] [--json] [--quiet]
  batch-add  --repo <path> --branch <name> --commit <sha> --pr-link <url> [--base <branch>] [--run-cmd <cmd>] [--json]
  batch-list [--json]
  batch-run  [--json] [--execute]

Examples:
  brainhome git preflight --repo /home/webserver
  brainhome git work-start D182A7 --repo /home/webserver --type feat --slug "git guardrails"
  brainhome git pr-ready --repo /home/webserver --base main
  brainhome git batch-add --repo /home/tools --branch feat/97E830-git-guardrails --commit fc4d557 --pr-link https://github.com/5t3mp3l/Tools/pull/new/feat/97E830-git-guardrails
  brainhome git batch-run --json
EOF
}

ensure_batch_file() {
  mkdir -p "$(dirname "$BATCH_FILE")"
  if [[ ! -f "$BATCH_FILE" ]]; then
    printf '{"entries": []}\n' > "$BATCH_FILE"
  fi
}

cmd_batch_add() {
  local repo=""
  local branch=""
  local commit=""
  local pr_link=""
  local base=""
  local run_cmd=""
  local out_json=0

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --repo) repo="$2"; shift 2 ;;
      --branch) branch="$2"; shift 2 ;;
      --commit) commit="$2"; shift 2 ;;
      --pr-link) pr_link="$2"; shift 2 ;;
      --base) base="$2"; shift 2 ;;
      --run-cmd) run_cmd="$2"; shift 2 ;;
      --json) out_json=1; shift ;;
      *) log_error "Unbekannte Option: $1"; exit 1 ;;
    esac
  done

  [[ -z "$repo" || -z "$branch" || -z "$commit" || -z "$pr_link" ]] && {
    log_error "Pflichtoptionen fehlen (repo/branch/commit/pr-link)"
    exit 1
  }

  ensure_repo "$repo"
  ensure_batch_file

  if [[ -z "$base" ]]; then
    base="$(default_branch "$repo")"
  fi
  [[ -z "$base" ]] && base="main"

  python3 - <<PY
import json
from datetime import datetime

path = "$BATCH_FILE"
repo = "$repo"
entry = {
  "repo": repo,
  "branch": "$branch",
  "commit": "$commit",
  "pr_link": "$pr_link",
  "base": "$base",
  "run_cmd": "$run_cmd",
  "updated_at": datetime.now().isoformat(timespec="seconds")
}
with open(path, "r", encoding="utf-8") as f:
  data = json.load(f)
entries = data.get("entries", [])
replaced = False
for i, e in enumerate(entries):
  if e.get("repo") == repo and e.get("branch") == entry["branch"]:
    entries[i] = entry
    replaced = True
    break
if not replaced:
  entries.append(entry)
data["entries"] = entries
with open(path, "w", encoding="utf-8") as f:
  json.dump(data, f, ensure_ascii=True, indent=2)
print(json.dumps({"ok": True, "replaced": replaced, "entry": entry}, ensure_ascii=True))
PY

  if [[ "$out_json" -ne 1 ]]; then
    log_success "Batch-Eintrag gespeichert: $repo [$branch]"
    log_info "Datei: $BATCH_FILE"
  fi
}

cmd_batch_list() {
  local out_json=0
  [[ "${1:-}" == "--json" ]] && out_json=1

  ensure_batch_file
  if [[ "$out_json" -eq 1 ]]; then
    cat "$BATCH_FILE"
    return 0
  fi

  python3 - <<PY
import json
path = "$BATCH_FILE"
with open(path, "r", encoding="utf-8") as f:
  data = json.load(f)
entries = data.get("entries", [])
if not entries:
  print("[INFO] Keine Batch-Eintraege vorhanden")
else:
  print(f"[INFO] Batch-Eintraege: {len(entries)}")
  for idx, e in enumerate(entries, 1):
    print(f"{idx}. repo={e.get('repo','')} branch={e.get('branch','')} commit={e.get('commit','')} base={e.get('base','main')}")
    print(f"   pr={e.get('pr_link','')}")
    if e.get('run_cmd'):
      print(f"   run_cmd={e.get('run_cmd')}")
PY
}

cmd_batch_run() {
  local out_json=0
  local execute=0

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --json) out_json=1; shift ;;
      --execute) execute=1; shift ;;
      *) log_error "Unbekannte Option: $1"; exit 1 ;;
    esac
  done

  ensure_batch_file

  local py_out
  py_out=$(python3 - <<PY
import json, os, subprocess

path = "$BATCH_FILE"
execute = bool($execute)
with open(path, "r", encoding="utf-8") as f:
  entries = json.load(f).get("entries", [])

results = []

def run(cmd, cwd=None):
  p = subprocess.run(cmd, cwd=cwd, text=True, capture_output=True)
  return p.returncode, (p.stdout or "").strip(), (p.stderr or "").strip()

for e in entries:
  repo = e.get("repo", "")
  branch = e.get("branch", "")
  commit = e.get("commit", "")
  base = e.get("base", "main")
  pr = e.get("pr_link", "")
  run_cmd = e.get("run_cmd", "")
  item = {
    "repo": repo,
    "branch": branch,
    "commit": commit,
    "base": base,
    "pr_link": pr,
    "checks": {},
    "ok": True,
  }

  if not os.path.isdir(repo):
    item["checks"]["repo_exists"] = False
    item["ok"] = False
    results.append(item)
    continue

  rc, _, _ = run(["git", "-C", repo, "rev-parse", "--git-dir"])
  item["checks"]["is_git_repo"] = (rc == 0)
  if rc != 0:
    item["ok"] = False
    results.append(item)
    continue

  run(["git", "-C", repo, "fetch", "origin", "--prune"])

  rc_local, _, _ = run(["git", "-C", repo, "show-ref", "--verify", "--quiet", f"refs/heads/{branch}"])
  rc_remote, _, _ = run(["git", "-C", repo, "show-ref", "--verify", "--quiet", f"refs/remotes/origin/{branch}"])
  item["checks"]["branch_exists"] = (rc_local == 0 or rc_remote == 0)

  rc, _, _ = run(["git", "-C", repo, "cat-file", "-e", f"{commit}^{{commit}}"])
  item["checks"]["commit_exists"] = (rc == 0)

  branch_ref = f"origin/{branch}" if rc_remote == 0 else branch
  rc, _, _ = run(["git", "-C", repo, "merge-base", "--is-ancestor", commit, branch_ref])
  item["checks"]["commit_in_branch"] = (rc == 0)

  item["checks"]["pr_link_present"] = bool(pr.startswith("http"))

  rc, out, _ = run(["bash", os.environ["BRAINHOME_GIT_SELF"], "preflight", "--repo", repo, "--allow-protected", "--allow-dirty", "--json"])
  try:
    item["checks"]["preflight"] = json.loads(out)
  except Exception:
    item["checks"]["preflight"] = {"ok": False, "raw": out}

  rc, out, _ = run(["bash", os.environ["BRAINHOME_GIT_SELF"], "pr-ready", "--repo", repo, "--base", base, "--json"])
  try:
    item["checks"]["pr_ready"] = json.loads(out)
  except Exception:
    item["checks"]["pr_ready"] = {"ok": False, "raw": out}

  if execute and run_cmd:
    rc, so, se = run(["bash", "-lc", run_cmd], cwd=repo)
    item["checks"]["run_cmd"] = {"ok": rc == 0, "exit_code": rc, "stdout": so, "stderr": se}

  bool_checks = [
    item["checks"].get("branch_exists", False),
    item["checks"].get("commit_exists", False),
    item["checks"].get("commit_in_branch", False),
    item["checks"].get("pr_link_present", False),
    bool(item["checks"].get("preflight", {}).get("ok", False)),
    bool(item["checks"].get("pr_ready", {}).get("ok", False)),
  ]
  if not all(bool_checks):
    item["ok"] = False

  results.append(item)

all_ok = all(r.get("ok", False) for r in results) if results else True
print(json.dumps({"ok": all_ok, "count": len(results), "results": results}, ensure_ascii=True))
PY
)

  if [[ -z "${py_out//[[:space:]]/}" ]]; then
    log_error "batch-run erzeugte keine Ausgabe"
    return 1
  fi

  if [[ "$out_json" -eq 1 ]]; then
    echo "$py_out"
  else
    printf '%s\n' "$py_out" | python3 -c 'import json,sys; data=json.load(sys.stdin); print(f"[INFO] Batch geprueft: {data.get("count",0)} Eintrag(e)");
for i,r in enumerate(data.get("results",[]),1):
  state="OK" if r.get("ok") else "FAIL"
  print(f"{i}. [{state}] {r.get("repo")} :: {r.get("branch")} @ {r.get("commit")}")
  ch=r.get("checks",{})
  print(f"   branch_exists={ch.get("branch_exists")} commit_exists={ch.get("commit_exists")} commit_in_branch={ch.get("commit_in_branch")} pr_link_present={ch.get("pr_link_present")}")
  print(f"   preflight_ok={ch.get("preflight",{}).get("ok")} pr_ready_ok={ch.get("pr_ready",{}).get("ok")}")
print(f"[INFO] Gesamtstatus: {'"'"'OK'"'"' if data.get("ok") else '"'"'FAIL'"'"'}")'
  fi

  local is_ok
  is_ok=$(echo "$py_out" | python3 -c 'import json,sys; print("1" if json.load(sys.stdin).get("ok") else "0")')
  [[ "$is_ok" == "1" ]] && return 0 || return 1
}

cmd_preflight() {
  local repo
  repo="$(pwd)"
  local allow_dirty=0
  local allow_protected=0
  local remote_check=1
  local out_json=0
  local quiet=0

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --repo) repo="$2"; shift 2 ;;
      --allow-dirty) allow_dirty=1; shift ;;
      --allow-protected) allow_protected=1; shift ;;
      --no-remote-check) remote_check=0; shift ;;
      --json) out_json=1; shift ;;
      --quiet) quiet=1; shift ;;
      *) log_error "Unbekannte Option: $1"; exit 1 ;;
    esac
  done

  ensure_repo "$repo"

  local branch dirty upstream_ok detached protected_ok dirty_ok remote_ok
  branch="$(current_branch "$repo")"
  detached=0
  [[ -z "$branch" ]] && detached=1

  dirty=0
  [[ -n "$(git -C "$repo" status --porcelain)" ]] && dirty=1

  upstream_ok=1
  if [[ "$detached" -eq 0 ]]; then
    git -C "$repo" rev-parse --abbrev-ref --symbolic-full-name "@{u}" >/dev/null 2>&1 || upstream_ok=0
  else
    upstream_ok=0
  fi

  protected_ok=1
  if [[ "$detached" -eq 0 ]] && is_protected_branch "$branch" && [[ "$allow_protected" -ne 1 ]]; then
    protected_ok=0
  fi

  dirty_ok=1
  if [[ "$dirty" -eq 1 && "$allow_dirty" -ne 1 ]]; then
    dirty_ok=0
  fi

  remote_ok=1
  if [[ "$remote_check" -eq 1 ]]; then
    git -C "$repo" ls-remote --heads origin >/dev/null 2>&1 || remote_ok=0
  fi

  local ok=1
  [[ "$detached" -eq 1 ]] && ok=0
  [[ "$upstream_ok" -ne 1 ]] && ok=0
  [[ "$protected_ok" -ne 1 ]] && ok=0
  [[ "$dirty_ok" -ne 1 ]] && ok=0
  [[ "$remote_ok" -ne 1 ]] && ok=0

  if [[ "$out_json" -eq 1 ]]; then
    python3 - <<PY
import json
print(json.dumps({
  "ok": bool($ok),
  "command": "preflight",
  "repo": "$repo",
  "branch": "$branch",
  "detached": bool($detached),
  "dirty": bool($dirty),
  "upstream_ok": bool($upstream_ok),
  "protected_ok": bool($protected_ok),
  "remote_ok": bool($remote_ok)
}, ensure_ascii=True))
PY
    [[ "$ok" -eq 1 ]] && exit 0 || exit 1
  fi

  if [[ "$quiet" -ne 1 ]]; then
    log_info "Repo: $repo"
    log_info "Branch: ${branch:-DETACHED}"
    [[ "$detached" -eq 0 ]] && log_success "Branch ist nicht detached" || log_error "Detached HEAD"
    [[ "$upstream_ok" -eq 1 ]] && log_success "Upstream vorhanden" || log_error "Kein Upstream gesetzt"
    [[ "$protected_ok" -eq 1 ]] && log_success "Nicht auf geschuetztem Branch" || log_error "Aktiver Branch ist geschützt (main/master)"
    [[ "$dirty_ok" -eq 1 ]] && log_success "Working tree okay" || log_error "Working tree ist dirty"
    if [[ "$remote_check" -eq 1 ]]; then
      [[ "$remote_ok" -eq 1 ]] && log_success "Remote origin erreichbar" || log_error "Remote origin nicht erreichbar"
    fi
  fi

  [[ "$ok" -eq 1 ]] && exit 0 || exit 1
}

cmd_work_start() {
  if [[ $# -lt 1 ]]; then
    log_error "Ticket-ID fehlt"
    exit 1
  fi

  local ticket="$1"
  shift

  local repo
  repo="$(pwd)"
  local typ="feat"
  local slug=""
  local base=""
  local allow_dirty=0
  local out_json=0
  local quiet=0

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --repo) repo="$2"; shift 2 ;;
      --type) typ="$2"; shift 2 ;;
      --slug) slug="$2"; shift 2 ;;
      --base) base="$2"; shift 2 ;;
      --allow-dirty) allow_dirty=1; shift ;;
      --json) out_json=1; shift ;;
      --quiet) quiet=1; shift ;;
      *) log_error "Unbekannte Option: $1"; exit 1 ;;
    esac
  done

  ensure_repo "$repo"

  local branch
  branch="$(current_branch "$repo")"
  if [[ -z "$branch" ]]; then
    log_error "Detached HEAD - work-start nicht moeglich"
    exit 1
  fi

  if [[ "$allow_dirty" -ne 1 ]] && [[ -n "$(git -C "$repo" status --porcelain)" ]]; then
    log_error "Working tree ist dirty. Nutze --allow-dirty falls bewusst."
    exit 1
  fi

  if [[ -z "$base" ]]; then
    base="$(default_branch "$repo")"
  fi
  if [[ -z "$base" ]]; then
    log_error "Konnte keinen Base-Branch bestimmen"
    exit 1
  fi

  if [[ -z "$slug" ]]; then
    slug="work"
  fi
  slug="$(sanitize_slug "$slug")"
  local new_branch="${typ}/${ticket}-${slug}"

  git -C "$repo" fetch origin --prune >/dev/null 2>&1 || true

  if git -C "$repo" show-ref --verify --quiet "refs/heads/$base"; then
    git -C "$repo" checkout "$base" >/dev/null 2>&1
  elif git -C "$repo" show-ref --verify --quiet "refs/remotes/origin/$base"; then
    git -C "$repo" checkout -b "$base" "origin/$base" >/dev/null 2>&1
  else
    log_error "Base-Branch nicht gefunden: $base"
    exit 1
  fi

  git -C "$repo" pull --ff-only origin "$base" >/dev/null 2>&1 || true

  if git -C "$repo" show-ref --verify --quiet "refs/heads/$new_branch"; then
    git -C "$repo" checkout "$new_branch" >/dev/null 2>&1
  else
    git -C "$repo" checkout -b "$new_branch" >/dev/null 2>&1
  fi

  local git_dir log_file
  git_dir="$(git -C "$repo" rev-parse --git-dir)"
  if [[ "$git_dir" != /* ]]; then
    git_dir="$repo/$git_dir"
  fi
  log_file="$git_dir/brainhome-work-start.log"
  printf '{"ts":"%s","ticket":"%s","branch":"%s","base":"%s"}\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$ticket" "$new_branch" "$base" >> "$log_file"

  if [[ "$out_json" -eq 1 ]]; then
    python3 - <<PY
import json
print(json.dumps({
  "ok": True,
  "command": "work-start",
  "repo": "$repo",
  "ticket": "$ticket",
  "base": "$base",
  "branch": "$new_branch"
}, ensure_ascii=True))
PY
    exit 0
  fi

  if [[ "$quiet" -ne 1 ]]; then
    log_success "Branch bereit: $new_branch"
    log_info "Base: $base"
    log_info "Repo: $repo"
  fi
}

cmd_pr_ready() {
  local repo
  repo="$(pwd)"
  local base=""
  local out_json=0
  local quiet=0

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --repo) repo="$2"; shift 2 ;;
      --base) base="$2"; shift 2 ;;
      --json) out_json=1; shift ;;
      --quiet) quiet=1; shift ;;
      *) log_error "Unbekannte Option: $1"; exit 1 ;;
    esac
  done

  ensure_repo "$repo"

  local branch
  branch="$(current_branch "$repo")"
  if [[ -z "$branch" ]]; then
    log_error "Detached HEAD - PR nicht bereit"
    exit 1
  fi

  if [[ -z "$base" ]]; then
    base="$(default_branch "$repo")"
  fi
  [[ -z "$base" ]] && base="main"

  local protected_ok=1
  is_protected_branch "$branch" && protected_ok=0

  local clean_ok=1
  [[ -n "$(git -C "$repo" status --porcelain)" ]] && clean_ok=0

  local base_ok=1
  if ! git -C "$repo" show-ref --verify --quiet "refs/heads/$base" && ! git -C "$repo" show-ref --verify --quiet "refs/remotes/origin/$base"; then
    base_ok=0
  fi

  local ahead=0
  if [[ "$base_ok" -eq 1 ]]; then
    ahead=$(git -C "$repo" rev-list --count "$base..HEAD" 2>/dev/null || echo 0)
  fi
  local ahead_ok=1
  [[ "$ahead" -le 0 ]] && ahead_ok=0

  local diff_check_ok=1
  git -C "$repo" diff --check >/dev/null 2>&1 || diff_check_ok=0
  git -C "$repo" diff --cached --check >/dev/null 2>&1 || diff_check_ok=0

  local changed_files=0
  if [[ "$base_ok" -eq 1 ]]; then
    changed_files=$(git -C "$repo" diff --name-only "$base...HEAD" | sed '/^$/d' | wc -l | tr -d ' ')
  fi

  local ok=1
  [[ "$protected_ok" -ne 1 ]] && ok=0
  [[ "$clean_ok" -ne 1 ]] && ok=0
  [[ "$base_ok" -ne 1 ]] && ok=0
  [[ "$ahead_ok" -ne 1 ]] && ok=0
  [[ "$diff_check_ok" -ne 1 ]] && ok=0

  if [[ "$out_json" -eq 1 ]]; then
    python3 - <<PY
import json
print(json.dumps({
  "ok": bool($ok),
  "command": "pr-ready",
  "repo": "$repo",
  "branch": "$branch",
  "base": "$base",
  "protected_ok": bool($protected_ok),
  "clean_ok": bool($clean_ok),
  "base_ok": bool($base_ok),
  "ahead_ok": bool($ahead_ok),
  "ahead_commits": int($ahead),
  "diff_check_ok": bool($diff_check_ok),
  "changed_files": int($changed_files)
}, ensure_ascii=True))
PY
    [[ "$ok" -eq 1 ]] && exit 0 || exit 1
  fi

  if [[ "$quiet" -ne 1 ]]; then
    log_info "Repo: $repo"
    log_info "Branch: $branch -> Base: $base"
    [[ "$protected_ok" -eq 1 ]] && log_success "Arbeitsbranch ist nicht protected" || log_error "Arbeitsbranch ist protected (main/master)"
    [[ "$clean_ok" -eq 1 ]] && log_success "Working tree ist clean" || log_error "Working tree nicht clean"
    [[ "$base_ok" -eq 1 ]] && log_success "Base-Branch vorhanden" || log_error "Base-Branch nicht gefunden"
    [[ "$ahead_ok" -eq 1 ]] && log_success "Commits vor Base vorhanden ($ahead)" || log_error "Keine Commits vor Base"
    [[ "$diff_check_ok" -eq 1 ]] && log_success "git diff --check ist sauber" || log_error "Whitespace/Marker-Probleme im Diff"
    log_info "Geaenderte Dateien: $changed_files"
  fi

  [[ "$ok" -eq 1 ]] && exit 0 || exit 1
}

main() {
  local cmd="${1:-help}"
  shift || true

  case "$cmd" in
    preflight) cmd_preflight "$@" ;;
    work-start) cmd_work_start "$@" ;;
    pr-ready) cmd_pr_ready "$@" ;;
    batch-add) cmd_batch_add "$@" ;;
    batch-list) cmd_batch_list "$@" ;;
    batch-run) cmd_batch_run "$@" ;;
    help|-h|--help) usage ;;
    *) log_error "Unbekannter git command: $cmd"; usage; exit 1 ;;
  esac
}

main "$@"
