#!/bin/bash
# =============================================================================
# brainhome-taskcheck — Validate module .vscode/tasks.json health
#
# Usage:
#   brainhome-taskcheck [module|all] [--json] [--fix]
# =============================================================================

set -euo pipefail

_SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
TOOLS_ROOT="${TOOLS_ROOT:-$(dirname "$_SCRIPT_DIR")}"
exec python3 "$TOOLS_ROOT/lib/task-health-check.py" "$@"
