  brainhome-devctl diff all --staged
  brainhome-devctl validate
  brainhome-devctl validate webserver --verbose
  brainhome-devctl validate all --json
  brainhome-devctl diagnose
  brainhome-devctl diagnose webserver
  brainhome-devctl diagnose webserver --json
  brainhome-devctl diagnose webserver --logs --log-lines=50
  brainhome-devctl env webserver
  brainhome-devctl env pihole --show-secrets
  brainhome-devctl env webserver --json
  brainhome-devctl watch webserver
  brainhome-devctl watch webserver --service=caddy
  brainhome-devctl watch all
  brainhome-devctl watch all --lines=20
  brainhome-devctl watch all --timeout=60
  brainhome-devctl snapshot
  brainhome-devctl snapshot --save
  brainhome-devctl snapshot --save --label=before-deploy
  brainhome-devctl snapshot webserver --save
  brainhome-devctl snapshot --diff
  brainhome-devctl snapshot --diff snap_a.json snap_b.json
  brainhome-devctl dep-order webserver
  brainhome-devctl dep-order webserver --json
  brainhome-devctl dep-order --all
  brainhome-devctl dep-order --all --json
  brainhome-devctl dep-order --all --json --strict
  brainhome-devctl dep-order --all --json --strict --summary
