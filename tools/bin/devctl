  brainhome-devctl cycle-check --text
  brainhome-devctl cycle-check --text --quiet
  brainhome-devctl cycle-check --text --quiet --silent
  brainhome-devctl cycle-check --output=count
  brainhome-devctl cycle-check --output=csv
  brainhome-devctl cycle-check --output=lines
  brainhome-devctl cycle-check --output=csv --sort
  brainhome-devctl cycle-check --output=csv --sort=desc
  brainhome-devctl cycle-check --output=csv --sep=';'
  brainhome-devctl cycle-check --strict --output=count
  brainhome-devctl cycle-check --strict --output=csv --sort
  brainhome-devctl cycle-check --ci
  brainhome-devctl cycle-check --ci=csv
  brainhome-devctl cycle-check --ci=lines
  brainhome-devctl cycle-check --no-cycles
  brainhome-devctl cycle-check --ci=lines --format='::error title=Dependency Cycle::{m}'
  brainhome-devctl cycle-check --output=lines --format='CYCLE: {m}'
  brainhome-devctl cycle-check --json --strict --summary

