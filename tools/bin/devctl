  brainhome-devctl context webserver --json     (Modul-fokus als JSON)

  # Debug-Template (rate-limit-sicher, strukturiert)
  brainhome-devctl ask                          (generisches Template)
  brainhome-devctl ask webserver                (mit Modul-Kontext)
  brainhome-devctl ask webserver backend        (+ Szenario: backend)
  brainhome-devctl ask webserver --with-context (Template + Infra-Context inline)
  brainhome-devctl ask --module pihole dns      (Modul + Szenario: dns)
  brainhome-devctl ask --scenario proxmox       (Proxmox-spezifisch)
  brainhome-devctl ask --scenario storage       (Storage/NAS-spezifisch)
  brainhome-devctl ask --scenario ha            (Home Assistant)
  brainhome-devctl ask --scenario network       (Netzwerk/OpenWrt)

  # Auto-detect module from current directory
  cd /home/webserver && devctl status
  cd /home/webserver && devctl logs
  cd /home/webserver && devctl ask
  cd /home/webserver && devctl context

For module-specific commands not listed here, use:
  /home/webserver/tools/devctl.sh <command>
  /home/brainhome-platform/tools/devctl.sh <command>

EOF
}

# ─── Main ─────────────────────────────────────────────────────────────────────

main() {
  if [ $# -eq 0 ]; then
    cmd_list
    return 0
  fi

  # Check for global commands first
  case "$1" in
    list|cycle-check|dep-order|discover|collect-logs|dashboard|tasks|taskcheck|smoketest|smokefix|context|ask|health|ssh|exec|ports|diff|validate|diagnose|env|watch|snapshot|help)
      case "$1" in
        list)    cmd_list ;;
        cycle-check)
          shift
          cmd_cycle_check "$@"
          ;;
        dep-order)
          shift
          cmd_dep_order "$@"
          ;;
        discover)
          log_info "Running module discovery..."
          python3 "$TOOLS_ROOT/lib/module-discovery.py" discover --no-cache >/dev/null 2>&1
          log_success "Discovery complete"
          "$TOOLS_ROOT/bin/brainhome-status"
          ;;
        collect-logs)
          shift
          cmd_collect_logs "$@"
          ;;
        dashboard)
          shift
          cmd_dashboard "$@"
          ;;
        tasks)
          shift
          cmd_tasks "$@"
          ;;
        taskcheck)
          shift
          cmd_taskcheck "$@"
          ;;
        smoketest)
          shift
          cmd_smoketest "$@"
          ;;
        smokefix)
          shift
          cmd_smokefix "$@"
          ;;
        context)
          shift
          cmd_context "$@"
          ;;
        ask)
          shift
          cmd_ask "$@"
          ;;
        health)
          shift
          cmd_health "$@"
          ;;
        ssh)
          shift
          cmd_ssh "$@"
          ;;
        exec)
          shift
          cmd_exec "$@"
          ;;
        ports)
          shift
          cmd_ports "$@"
          ;;
        diff)
          shift
          cmd_diff "$@"
          ;;
        validate)
          shift
          cmd_validate "$@"
          ;;
        diagnose)
          shift
          cmd_diagnose "$@"
          ;;
        env)
          shift
          cmd_env "$@"
          ;;
        watch)
          shift
          cmd_watch "$@"
          ;;
        snapshot)
          shift
          cmd_snapshot "$@"
          ;;
        help)    cmd_help ;;
      esac
      return 0
      ;;
  esac

  # Check if first arg is a known module
  local module=""
  local cmd=""

  if [ -f "$MODULES_JSON" ] && jq -e ".modules.\"$1\"" "$MODULES_JSON" >/dev/null 2>&1; then
    # First arg is module name
    module="$1"
    cmd="${2:-status}"
    shift 2
  else
    # Try auto-detect or treat as command
    module=$(detect_module 2>/dev/null || true)
    if [ -z "$module" ]; then
      # No module, treat as command (if valid)
      case "$1" in
        status|logs|start|stop|restart)
          log_error "Command '$1' requires a module"
          log_error "Usage: brainhome-devctl <module> $1"
          return 1
          ;;
        *)
          log_error "Module not specified and not auto-detected"
          log_error "Usage: brainhome-devctl <module> <command>"
          return 1
          ;;
      esac
    else
      cmd="$1"
      shift
    fi
  fi

  # Execute command
  case "$cmd" in
    status)
      cmd_status "$module" "$@"
      ;;
    logs)
      cmd_logs "$module" "$@"
      ;;
    start)
      cmd_start "$module" "$@"
      ;;
    stop)
      cmd_stop "$module" "$@"
      ;;
    restart)
      cmd_restart "$module" "$@"
      ;;
    *)
      # Delegate to module-local tools/devctl.sh if present (two-tier tooling)
      local module_path_local
      module_path_local=$(get_module_path "$module" 2>/dev/null || true)
      local local_devctl="$module_path_local/tools/devctl.sh"
      if [ -n "$module_path_local" ] && [ -f "$local_devctl" ]; then
        exec bash "$local_devctl" "$cmd" "$@"
      fi
      log_error "Unknown command for module '$module': $cmd"
      log_error "Available commands: status, logs, start, stop, restart"
      log_error "Tip: module-local commands require tools/devctl.sh in the module root"
      return 1
      ;;
  esac
}

main "$@"
